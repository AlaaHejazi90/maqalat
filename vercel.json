{
  "buildCommand": "node build.js",
  "outputDirectory": "public",
  "installCommand": "",
  "framework": null,
  "cleanUrls": true,
  "headers": [
    { "source": "/a/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }, { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
    { "source": "/links(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }
  ]
}
